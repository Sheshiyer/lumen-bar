{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lumenbar-site",
  "account_id": "9d7cec1b5a32b2df8c6cdc1321ccd00b",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "main": "./src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "previews": {},
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
